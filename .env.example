ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000

# Bank Verify — Paystack test or live secret key
# Get yours at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_test_secret_key_here

# Admin gate — when SET, the Self-Check Agent at /admin/diagnostics and its
# /diagnostics/* API endpoints require this exact value in the X-Admin-Secret
# header. When UNSET, those endpoints are open (fine for local dev). Set it
# before deploying anywhere public to hide the diagnostic from regular users.
#
# Generate something hard to guess, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=

# ERPNext / Frappe knowledge-base sync (optional) — pulls document
# attachments from ERPNext into the Knowledge Hub so they become
# retrieval-searchable. In ERPNext: User > API Access > Generate Keys.
ERPNEXT_URL=https://erp.your-org.org
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Odoo knowledge-base sync (optional) — pulls ir.attachment documents from
# Odoo via XML-RPC. API key: Odoo > Settings > Account Security > API Keys.
ODOO_URL=https://your-org.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# ─── Error reporting ────────────────────────────────────────────────────────
# Inert unless set. PII is never sent and credentials are scrubbed.
SENTRY_DSN=
DOCEX_ENV=production

# ─── AI spend limits (fail closed) ──────────────────────────────────────────
# Model calls are the only unbounded cost in the system. These cap a burst, a
# day's volume, and a day's spend independently. Set to 0 to disable a guard.
DOCEX_LLM_RATE_PER_MIN=20
DOCEX_LLM_DAILY_CALLS=500
DOCEX_LLM_DAILY_USD=25

# ─── Kill switches ──────────────────────────────────────────────────────────
# Disable something expensive or misbehaving WITHOUT a deploy. Environment
# rather than database, so it still works when the database is the problem.
# DOCEX_KILL_LLM=1
# DOCEX_KILL_UPLOADS=1
# DOCEX_KILL_ALL=1
