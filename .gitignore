# Python
.venv/
__pycache__/
*.pyc
*.pyo
.env

# Secrets — the HMAC signing key for approval magic-links is generated at
# runtime and must NEVER be committed (this repo is public). Prefer setting
# APPROVAL_SECRET as an env var so it isn't written to disk at all.
.approval_secret
*.pem
*.key

# Next.js
web/.next/
web/node_modules/
web/.env.local
web/tsconfig.tsbuildinfo

# Runtime data — these dirs hold user-generated records, not source. In
# production they live on a mounted volume (Railway/Fly). Locally they stay
# in your working copy but are never committed.
#
# Note: we ignore the CONTENTS of these dirs rather than the dirs themselves,
# so that (a) the dir structure stays in source (handy for fresh checkouts)
# and (b) we can re-include specific files via !-exception below.
rulebooks/*
checks/*
verifications/*
attendance_runs/*
rate_cards/*
decks/*
diagnostics/*
demos/*
demo_uploads/*
demo_users/*
analytics/*

# EXCEPTION: the seeded sample rulebook IS source — it ships in the Docker
# image so first-time users see something in their library on Day 1.
!rulebooks/sample-ngo-procurement.json

# Logs — runtime log files are noise, never source.
*.log

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
.vercel
