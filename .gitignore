# Python
.venv/
__pycache__/
*.pyc
*.pyo
.env

# Secrets — the HMAC signing key for approval magic-links is generated at
# runtime and must NEVER be committed (this repo is public). Prefer setting
# APPROVAL_SECRET as an env var so it isn't written to disk at all.
.approval_secret
*.pem
*.key

# Next.js
web/.next/
web/node_modules/
web/.env.local
web/tsconfig.tsbuildinfo

# Runtime data — these dirs hold user-generated records, not source. In
# production they live on a mounted volume (Railway/Fly). Locally they stay
# in your working copy but are never committed.
#
# Note: we ignore the CONTENTS of these dirs rather than the dirs themselves,
# so that (a) the dir structure stays in source (handy for fresh checkouts)
# and (b) we can re-include specific files via !-exception below.
rulebooks/*
rulebook_jobs/*
checks/*
verifications/*
attendance_runs/*
rate_cards/*
decks/*
diagnostics/*
demos/*
demo_uploads/*
demo_users/*
analytics/*

# EXCEPTION: the seeded sample rulebook IS source — it ships in the Docker
# image so first-time users see something in their library on Day 1.
!rulebooks/sample-ngo-procurement.json

# Logs — runtime log files are noise, never source.
*.log

# ERP runtime data — created at runtime, ephemeral on Render, never source.
# Local JSON data stores at the REPO ROOT — anchored with a leading slash.
#
# These were bare patterns (`users/`, `transactions/`…), and a bare pattern
# matches a directory of that name at ANY depth. So they silently swallowed
# three real source directories:
#
#   web/app/settings/users/      — People & access, the user-management screen
#   web/app/transactions/[ref]/  — transaction detail
#   web/app/vouchers/new/        — voucher builder
#
# Those pages existed, compiled, passed tsc, and 404'd in production, because
# they were never committed. `git status` stayed clean the whole time, which is
# what made it invisible: nothing was ever reported as missing.
#
# The leading slash confines each pattern to the repo root, which is the only
# place the data directories ever were.
/transactions/
/notifications/
/users/
/vouchers/

# Auth / signing secrets — MUST never be committed.
.auth_secret
.approval_secret

# Virtualenvs (both names seen in this repo) — never source.
venv/
.venv/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
.vercel

# Local JSON store (store.py JsonFileStore default root). Runtime data —
# recreated on demand, and never something that should reach the repo.
/data/

# Generated demo documents — rebuild with `python3 make_demo_docs.py`
/demo_docs/

# Commercial material — pricing, margins, cost structure, prospect lists.
# Deliberately NOT in the repo: our data-ownership terms let a client take the
# source code on termination, and a contractor may get repo access. Neither
# should be able to read our margin on their own account.
# These files live on disk in business/ and are backed up separately.
business/

# Local demo database and its SQLite sidecars. Regenerated by demo_seed.py in
# seconds, and it holds throwaway data — there is no reason to track it, and
# every reason not to track a database file.
demo.db
*.db-shm
*.db-wal

# Generated locally by spend_report.py --html
spend_report.html
