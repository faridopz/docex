# Files NOT to copy into the Docker image — keeps it small and avoids
# leaking secrets or shipping the frontend build into the backend container.

# Frontend (deployed separately to Vercel)
web/

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — these must come via env vars, never baked into the image
.env
.env.local
.auth_secret

# Local data. These are gitignored, so a Render build (which comes from git)
# never sees them — but `docker build` from a working copy would, and
# auth.migrate_legacy_users() imports users/ into whatever org the container
# serves. That would have created a stale developer admin account, with a
# password nobody remembers, inside a client's production database.
users/
data/
backups/
*.db
*.db-wal
*.db-shm
checks/
rulebooks/
transactions/
notifications/
vouchers/
verifications/
attendance_runs/
diagnostics/
decks/
demo_docs/
demov2/

# Version control + editor
.git/
.gitignore
.gitattributes
.DS_Store
*.swp
*.swo

# IDE
.vscode/
.idea/

# Docs / assets that don't ship
*.md
docexassets/
DOCex_overview.pdf
docker-compose.yml

# Persistent data / scratch dirs — recreated at boot; never ship into the image
rulebooks/
checks/
verifications/
attendance_runs/
rate_cards/
decks/
diagnostics/
demov2/
terraform/
deploy/
portfolio/
brand-kit/

# Build artifacts
build/
dist/
*.egg-info/
